rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{publisherId}/{bookId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null &&
                               request.auth.uid == publisherId &&
                               request.resource.size < 10 * 1024 * 1024 &&
                               request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == publisherId;
    }

    match /books/{publisherId}/{bookId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == publisherId ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/library/$(bookId))
      );
      allow create, update: if request.auth != null &&
                               request.auth.uid == publisherId &&
                               request.resource.size < 100 * 1024 * 1024 &&
                               (
                                 request.resource.contentType == 'application/epub+zip' ||
                                 request.resource.contentType == 'application/pdf'
                               );
      allow delete: if request.auth != null && request.auth.uid == publisherId;
    }
  }
}