rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isActivePublisher() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'publisher' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    match /covers/{publisherId}/{bookId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && (
        (request.auth.uid == publisherId && isActivePublisher()) ||
        isAdmin()
      ) && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && (request.auth.uid == publisherId || isAdmin());
    }

    match /books/{publisherId}/{bookId}/{fileName} {
      allow read: if isSignedIn() && (
        request.auth.uid == publisherId ||
        isAdmin() ||
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/library/$(bookId))
      );
      allow create, update: if isSignedIn() && (
        (request.auth.uid == publisherId && isActivePublisher()) ||
        isAdmin()
      ) && request.resource != null
        && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isSignedIn() && (request.auth.uid == publisherId || isAdmin());
    }
  }
}